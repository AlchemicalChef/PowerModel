# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
power_model-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Rust NIF build artifacts (rebuilt by mix compile via Rustler)
/native/sparse_solver/target/

# macOS metadata
.DS_Store

# Bulk source datasets (downloaded, not versioned — see README/mix tasks
# for sources: EIA-860, EPA eGRID, EIA-930 grid monitor bulk files).
#
# `/data/*` rather than `/data/`: git does not descend into an excluded
# DIRECTORY, so a `!data/vendored/…` negation below cannot re-include anything
# while the parent is excluded wholesale. PROVENANCE.md only escaped that
# because it was already tracked, and gitignore does not apply to tracked
# files — a new file next to it would have been silently dropped.
/data/*
!/data/vendored/

# Generated map exports (rebuild with: mix power_model.export_grid_data)
/priv/static/grid_data/

data/vendored/*
!data/vendored/PROVENANCE.md
# Not bulk source data: the record of which rows we CHANGED and their prior
# values. The raw snapshots beside it are re-fetchable from PROVENANCE.md, this
# is not — losing it loses the ability to reverse the corrections.
!data/vendored/osm_corridor_corrections_2026-08-18.json
# Same rule, same reason: the derived work list (which yards have an OSM
# circuit above their POI floor, with way ids) is the attribution record and
# is not re-derivable without the raw pull, which is.
!data/vendored/osm_stranded_worklist_2026-08-23.csv

# Byte-compiled helper scripts (scripts/*.py)
__pycache__/
*.pyc

# Compiled NIF (Rustler copies it into priv/native during mix compile)
/priv/native/
